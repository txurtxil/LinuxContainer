<?xml version="1.0" encoding="utf-8"?>
<!-- Fila SFTP compacta: icono 26dp + una sola linea "etiqueta — host". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="2dp">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:padding="5dp"
        android:src="@drawable/widget_ic_folder"
        android:background="@drawable/widget_avatar_sftp"
        android:contentDescription="SFTP" />

    <TextView
        android:id="@+id/row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="/ruta"
        android:textColor="#EAEAEC"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>

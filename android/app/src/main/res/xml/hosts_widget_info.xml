<?xml version="1.0" encoding="utf-8"?>
<!-- Celdas launcher: 70*n-30 dp -> 2 celdas = 110dp, 3 celdas = 180dp.
     El widget nace en 3x2 (antes 4x3: ocupaba media pantalla) y se
     adapta: HostsWidgetProvider elige layout normal/compacto segun las
     celdas reales en onUpdate y onAppWidgetOptionsChanged. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_hosts"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
